  "keyFeatures": [
    "Private staff authentication with invitation-only onboarding",
    "Patient record management with comprehensive medical history",
    "Clinical session drafts with autosave and completion workflow",
    "Superadmin user management and invitation flow",
    "Row-Level Security (RLS) for strict data ownership",
    "Session expiry warning UI",
    "Google OAuth and email/password authentication",
    "E2E test coverage with Playwright"
  ],
  "publicApiSurface": [
    "POST /auth/callback — OAuth callback handler",
    "GET /login — Authentication page",
    "GET /patients — Patient listing with search",
    "GET /patients/[patientId] — Patient detail with tabs",
    "POST /patients — Create patient (Server Action)",
    "GET /patients/[patientId]/sessions/new — New clinical session",
    "GET /patients/[patientId]/sessions/[sessionId] — Clinical session editor with autosave",
    "GET /admin/users — User administration (superadmin only)",
    "GET /profile — Profile management page",
    "patientFormSchema — Zod schema for patient creation/update",
    "clinicalSessionFormSchema — Zod schema for clinical session",
    "complete_user_onboarding() — PostgreSQL function for first login",
    "db:link / db:push / db:types — Supabase CLI database scripts"
  ]
}
